{
	"name": "kncaptcha",
	"version": "2.0.0",
	"description": "Privacy-friendly proof-of-work captcha: memory-hard Equihash puzzles solved in the browser, verified in microseconds by the server. Vanilla JS widget and Vue 3 component.",
	"keywords": [
		"captcha",
		"proof-of-work",
		"pow",
		"equihash",
		"anti-bot",
		"bot-protection",
		"privacy",
		"vue",
		"typescript"
	],
	"license": "MIT",
	"author": "Florent VIALATTE (https://github.com/Karewan)",
	"homepage": "https://github.com/Karewan/KnCaptcha",
	"type": "module",
	"sideEffects": [
		"*.css"
	],
	"files": [
		"dist",
		"README.md",
		"PROTOCOL.md",
		"CHANGELOG.md",
		"LICENSE.txt"
	],
	"main": "./dist/kncaptcha.js",
	"module": "./dist/kncaptcha.js",
	"types": "./dist/types/index.d.ts",
	"unpkg": "./dist/kncaptcha.iife.js",
	"jsdelivr": "./dist/kncaptcha.iife.js",
	"exports": {
		".": {
			"types": "./dist/types/index.d.ts",
			"import": "./dist/kncaptcha.js"
		},
		"./vue": {
			"types": "./dist/types/vue.d.ts",
			"import": "./dist/vue.js"
		},
		"./style.css": "./dist/kncaptcha.css",
		"./worker": "./dist/kncaptcha.worker.js",
		"./package.json": "./package.json"
	},
	"scripts": {
		"dev": "vite",
		"build": "vite build && vite build --mode iife && vite build --mode worker && tsc -p tsconfig.build.json && node scripts/css.mjs",
		"typecheck": "tsc --noEmit",
		"lint": "biome check",
		"lint:fix": "biome check --write",
		"test": "vitest run",
		"test:watch": "vitest",
		"icons": "node scripts/icons.mjs && biome format --write src/icons.ts",
		"vectors": "UPDATE_VECTORS=1 vitest run tests/vectors.test.ts",
		"bench": "BENCH=1 vitest run tests/bench.test.ts"
	},
	"peerDependencies": {
		"vue": "^3.3.0"
	},
	"peerDependenciesMeta": {
		"vue": {
			"optional": true
		}
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.14",
		"@tabler/icons": "^3.48.0",
		"@types/node": "^26.6.3",
		"@vue/test-utils": "^2.5.1",
		"happy-dom": "^20.14.5",
		"typescript": "^7.0.2",
		"vite": "^8.3.1",
		"vitest": "^5.0.2",
		"vue": "^3.5.43"
	}
}
